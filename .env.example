# Copy this file to ".env" and adjust if you like, then run:
#   docker compose up -d --build
#
# MOODLE_WWWROOT must match the address you open in your browser.
# For a local machine, http://localhost:8080 is fine. On a remote server,
# set it to http://SERVER_IP:8080 (or a domain) and keep HTTP_PORT in sync.

# MOODLE_BRANCH: while Moodle 5.3 is in QA (stable 5 October 2026) its code is
# on the development branch "main". After 5.3 is released, change this to
# MOODLE_503_STABLE to track the stable 5.3 line.
MOODLE_BRANCH=main
DB_NAME=moodle
DB_USER=moodle
DB_PASS=change-this-db-password
MOODLE_WWWROOT=http://localhost:8080
MOODLE_ADMIN_PASS=Change-this-admin-pass1!
HTTP_PORT=8080

# --- HTTPS behind a reverse proxy (e.g. YunoHost nginx) ---
# When a host-side proxy terminates HTTPS and forwards to this container:
#   1. Set MOODLE_WWWROOT to the https:// domain (no port), e.g.
#      MOODLE_WWWROOT=https://moodle53dev.example.org
#   2. Set MOODLE_SSLPROXY=true so Moodle knows the outside is HTTPS.
#   3. Set BIND_HOST=127.0.0.1 so the port is reachable only by the proxy,
#      not directly from the internet.
MOODLE_SSLPROXY=false
BIND_HOST=0.0.0.0
