# Copy this file to ".env" and adjust if you like, then run:
#   docker compose up -d --build
#
# MOODLE_WWWROOT must match the address you open in your browser.
# For a local machine, http://localhost:8080 is fine. On a remote server,
# set it to http://SERVER_IP:8080 (or a domain) and keep HTTP_PORT in sync.

# MOODLE_BRANCH: while Moodle 5.3 is in QA (stable 5 October 2026) its code is
# on the development branch "main". After 5.3 is released, change this to
# MOODLE_503_STABLE to track the stable 5.3 line.
MOODLE_BRANCH=main
DB_NAME=moodle
DB_USER=moodle
DB_PASS=change-this-db-password
MOODLE_WWWROOT=http://localhost:8080
MOODLE_ADMIN_PASS=Change-this-admin-pass1!
HTTP_PORT=8080

# --- HTTPS behind a reverse proxy (e.g. YunoHost nginx) ---
# When a host-side proxy terminates HTTPS and forwards to this container:
#   1. Set MOODLE_WWWROOT to the https:// domain (no port), e.g.
#      MOODLE_WWWROOT=https://moodle53dev.example.org
#   2. Set MOODLE_SSLPROXY=true so Moodle knows the outside is HTTPS.
#   3. Set BIND_HOST=127.0.0.1 so the port is reachable only by the proxy,
#      not directly from the internet.
MOODLE_SSLPROXY=false
BIND_HOST=0.0.0.0

# The image installs Composer dependencies and configures Moodle's router
# (Moodle 5.1+). Leave MOODLE_ROUTER=true so $CFG->routerconfigured is set to
# match the Apache router rewrite baked into the image.
MOODLE_ROUTER=true

# Apply any pending Moodle DB upgrade automatically on start. Useful when
# tracking a moving branch (main), where a rebuild can pull code newer than the
# database. Set false to handle upgrades manually.
MOODLE_AUTO_UPGRADE=true

# --- PHP & performance (the config-panel equivalents) ---
# Applied on container start; change a value then `docker compose up -d` to
# apply. Note: when serving through a reverse proxy, uploads are also capped by
# the proxy's client_max_body_size (raise it there too for large uploads).
PHP_MEMORY_LIMIT=256M
PHP_MAX_INPUT_VARS=5000
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=1G

# --- Cron ---
# Minutes between Moodle cron runs. The YunoHost package defaults to 15, but
# Moodle's task scheduler expects cron every 1 minute and warns if it runs less
# often - set CRON_INTERVAL=1 to keep Moodle's health check happy.
CRON_INTERVAL=15
